{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anantarultimate.com/api/v1.schema.json",
  "title": "Infinity Core API v1 (draft 2026-11-25)",
  "description": "Objects and messages of SPEC.md. Unknown fields are allowed everywhere: v1 grows by adding.",
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "Scope": {
      "enum": [
        "read",
        "control",
        "library",
        "library.manage",
        "sound"
      ]
    },
    "Service": {
      "enum": [
        "lyrics",
        "album_info",
        "artist_info",
        "cover",
        "track_identify",
        "actions",
        "volume_control",
        "source_control",
        "status",
        "settings",
        "radio"
      ]
    },
    "Event": {
      "enum": [
        "zone.changed",
        "zone.removed",
        "queue.changed",
        "outputs.changed",
        "library.changed"
      ]
    },
    "Hello": {
      "type": "object",
      "required": [
        "api",
        "id",
        "name",
        "version",
        "publisher",
        "uses",
        "provides"
      ],
      "properties": {
        "api": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "version": {
          "type": "string",
          "maxLength": 40
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "homepage": {
          "type": "string",
          "format": "uri",
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "maxLength": 200
        },
        "uses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Scope"
          },
          "uniqueItems": true
        },
        "provides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Service"
          },
          "uniqueItems": true
        },
        "token": {
          "type": "string"
        }
      }
    },
    "HelloResult": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "enabled",
            "waiting",
            "disabled",
            "blocked",
            "upgrade"
          ]
        },
        "token": {
          "type": "string"
        },
        "grant": {
          "$ref": "#/$defs/Grant"
        },
        "pending": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Scope"
              },
              {
                "$ref": "#/$defs/Service"
              }
            ]
          }
        },
        "reason": {
          "type": "string"
        },
        "core": {
          "$ref": "#/$defs/CoreInfo"
        }
      }
    },
    "Grant": {
      "type": "object",
      "required": [
        "scopes",
        "actsAs"
      ],
      "properties": {
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Scope"
          }
        },
        "actsAs": {
          "oneOf": [
            {
              "const": "everyone"
            },
            {
              "type": "object",
              "required": [
                "profile",
                "name"
              ],
              "properties": {
                "profile": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    },
    "CoreInfo": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "api",
        "preview"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "api": {
          "type": "integer"
        },
        "preview": {
          "type": "boolean"
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProfileRef"
          }
        }
      }
    },
    "ProfileRef": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "Volume": {
      "type": "object",
      "required": [
        "value",
        "min",
        "max",
        "step",
        "unit",
        "muted",
        "fixed"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "dB",
            "percent",
            "steps"
          ]
        },
        "muted": {
          "type": "boolean"
        },
        "fixed": {
          "type": "boolean"
        }
      }
    },
    "Output": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "computer",
            "dap",
            "upnp",
            "cast",
            "airplay",
            "extension"
          ]
        },
        "volume": {
          "$ref": "#/$defs/Volume"
        },
        "inUse": {
          "type": "object",
          "properties": {
            "profile": {
              "$ref": "#/$defs/ProfileRef"
            }
          }
        }
      }
    },
    "Quality": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string"
        },
        "sampleRate": {
          "type": "integer"
        },
        "bitDepth": {
          "type": "integer"
        }
      }
    },
    "Track": {
      "type": "object",
      "required": [
        "id",
        "title",
        "artists",
        "duration",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "title": {
          "type": "string"
        },
        "artists": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "album": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/Id"
            },
            "title": {
              "type": "string"
            }
          }
        },
        "albumArtist": {
          "type": "string"
        },
        "disc": {
          "type": "integer"
        },
        "number": {
          "type": "integer"
        },
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "source": {
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/Quality"
        },
        "image": {
          "$ref": "#/$defs/Id"
        }
      }
    },
    "Album": {
      "type": "object",
      "required": [
        "id",
        "title",
        "artist",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "title": {
          "type": "string"
        },
        "artist": {
          "type": "string"
        },
        "year": {
          "type": "integer"
        },
        "tracks": {
          "type": "integer"
        },
        "source": {
          "type": "string"
        },
        "image": {
          "$ref": "#/$defs/Id"
        }
      }
    },
    "Artist": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string"
        },
        "image": {
          "$ref": "#/$defs/Id"
        }
      }
    },
    "Playlist": {
      "type": "object",
      "required": [
        "id",
        "name",
        "tracks",
        "editable"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string"
        },
        "tracks": {
          "type": "integer"
        },
        "image": {
          "$ref": "#/$defs/Id"
        },
        "editable": {
          "type": "boolean"
        }
      }
    },
    "NowPlaying": {
      "type": "object",
      "required": [
        "track",
        "position",
        "at",
        "playing"
      ],
      "properties": {
        "track": {
          "$ref": "#/$defs/Track"
        },
        "position": {
          "type": "number",
          "minimum": 0
        },
        "at": {
          "type": "integer",
          "description": "the Core's clock, ms since 1970"
        },
        "playing": {
          "type": "boolean"
        }
      }
    },
    "Zone": {
      "type": "object",
      "required": [
        "id",
        "name",
        "profile",
        "state",
        "output",
        "queue",
        "shuffle",
        "repeat",
        "private"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/ProfileRef"
        },
        "state": {
          "enum": [
            "playing",
            "paused",
            "stopped",
            "loading"
          ]
        },
        "output": {
          "$ref": "#/$defs/Output"
        },
        "nowPlaying": {
          "$ref": "#/$defs/NowPlaying"
        },
        "queue": {
          "type": "object",
          "required": [
            "total",
            "position"
          ],
          "properties": {
            "total": {
              "type": "integer"
            },
            "position": {
              "type": "integer"
            }
          }
        },
        "shuffle": {
          "type": "boolean"
        },
        "repeat": {
          "enum": [
            "off",
            "all",
            "one"
          ]
        },
        "private": {
          "type": "boolean"
        }
      }
    },
    "LyricsResult": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "synced": {
              "type": "string",
              "maxLength": 200000
            },
            "plain": {
              "type": "string",
              "maxLength": 200000
            },
            "instrumental": {
              "const": true
            }
          }
        }
      ]
    },
    "AlbumSearchResult": {
      "type": "object",
      "required": [
        "results"
      ],
      "properties": {
        "results": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "id",
              "album"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/Id"
              },
              "album": {
                "type": "string",
                "maxLength": 500
              },
              "artist": {
                "type": "string",
                "maxLength": 500
              },
              "year": {
                "type": "integer"
              },
              "tracks": {
                "type": "integer"
              },
              "cover": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      }
    },
    "AlbumResult": {
      "type": "object",
      "required": [
        "album",
        "tracks"
      ],
      "properties": {
        "album": {
          "type": "string",
          "maxLength": 500
        },
        "albumArtist": {
          "type": "string",
          "maxLength": 500
        },
        "date": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "genre": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cover": {
          "type": "string",
          "format": "uri"
        },
        "tracks": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "required": [
              "number",
              "title"
            ],
            "properties": {
              "disc": {
                "type": "integer"
              },
              "number": {
                "type": "integer"
              },
              "title": {
                "type": "string",
                "maxLength": 500
              },
              "artist": {
                "type": "string",
                "maxLength": 500
              },
              "durationMs": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "ArtistResult": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "bio": {
              "type": "object",
              "required": [
                "text",
                "lang"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "maxLength": 20000
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "lang": {
                  "type": "string"
                }
              }
            },
            "image": {
              "type": "string",
              "format": "uri"
            },
            "members": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  }
                }
              }
            },
            "born": {
              "type": "string"
            },
            "formed": {
              "type": "string"
            },
            "links": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "url"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "CoverSearchResult": {
      "type": "object",
      "required": [
        "results"
      ],
      "properties": {
        "results": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              },
              "label": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "IdentifyResult": {
      "type": "object",
      "required": [
        "results"
      ],
      "properties": {
        "results": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "score",
              "title",
              "artist"
            ],
            "properties": {
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "title": {
                "type": "string"
              },
              "artist": {
                "type": "string"
              },
              "album": {
                "type": "string"
              },
              "albumId": {
                "$ref": "#/$defs/Id"
              }
            }
          }
        }
      }
    },
    "ActionsSet": {
      "type": "object",
      "required": [
        "actions"
      ],
      "properties": {
        "actions": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "on"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/Id"
              },
              "label": {
                "type": "string",
                "maxLength": 40
              },
              "on": {
                "type": "array",
                "items": {
                  "enum": [
                    "track",
                    "album",
                    "artist"
                  ]
                },
                "minItems": 1
              }
            }
          }
        }
      }
    },
    "ActionResult": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "maxLength": 200
        },
        "open": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "SettingsField": {
      "type": "object",
      "required": [
        "id",
        "label",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "label": {
          "type": "string",
          "maxLength": 60
        },
        "type": {
          "enum": [
            "text",
            "secret",
            "toggle",
            "choice",
            "number"
          ]
        },
        "help": {
          "type": "string",
          "maxLength": 200
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ]
          }
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "Manifest": {
      "type": "object",
      "required": [
        "api",
        "id",
        "name",
        "version",
        "publisher",
        "provides"
      ],
      "properties": {
        "api": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
        },
        "name": {
          "type": "string",
          "maxLength": 40
        },
        "version": {
          "type": "string"
        },
        "publisher": {
          "type": "string",
          "maxLength": 60
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": "string",
          "maxLength": 200
        },
        "provides": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "lyrics",
              "album_info",
              "artist_info",
              "cover",
              "radio"
            ]
          }
        }
      }
    },
    "RadioSearchResult": {
      "type": "object",
      "required": [
        "stations"
      ],
      "properties": {
        "stations": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "url"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/Id"
              },
              "name": {
                "type": "string",
                "maxLength": 120
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "logo": {
                "type": "string",
                "format": "uri"
              },
              "country": {
                "type": "string"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "codec": {
                "type": "string"
              },
              "bitrate": {
                "type": "integer"
              },
              "homepage": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      }
    }
  }
}
